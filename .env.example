# 모든 변수는 선택 사항입니다. 하나도 설정하지 않아도 앱은 번들된 DEMO 모델·데이터로 동작합니다.
# 비밀키는 절대 커밋하지 마세요(.env.local 은 .gitignore 처리됨). NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출됩니다.

# Supabase (서버 전용) — 설정하면 REAL 업로드 영속 저장·조회·다운로드, 예측 로그가 활성화됩니다.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 실데이터 쓰기/조회/다운로드 보호용 토큰 (긴 임의 문자열). 미설정이면 업로드는 '검증 미리보기'만 가능.
UPLOAD_TOKEN=change-me-to-a-long-random-string

# true 로 설정하면 /api/predict 호출을 prediction_logs 테이블에 기록합니다.
LOG_PREDICTIONS=false
